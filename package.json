{
  "name": "@cookiebytes/n8n-nodes-invoicexpress",
  "version": "0.1.0",
  "description": "n8n community node for the InvoiceXpress API (invoices, estimates, guides, clients, items, taxes, sequences)",
  "keywords": [
    "n8n-community-node-package",
    "invoicexpress",
    "invoicing",
    "portugal"
  ],
  "homepage": "https://github.com/cookiebytespt/n8n-invoiceXpress",
  "bugs": {
    "url": "https://github.com/cookiebytespt/n8n-invoiceXpress/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookiebytespt/n8n-invoiceXpress.git"
  },
  "license": "MIT",
  "author": {
    "name": "CookieBytes",
    "email": "hello@cookiebytes.pt"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/InvoiceXpressApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/InvoiceXpress/InvoiceXpress.node.js"
    ]
  }
}
